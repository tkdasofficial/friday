{
  "expo": {
    "name": "FRIDAY",
    "slug": "friday",
    "owner": "friday-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "friday",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#03060F"
    },
    "ios": {
      "supportsTablet": false,
      "backgroundModes": [
        "audio",
        "fetch",
        "processing",
        "remote-notification"
      ],
      "infoPlist": {
        "NSMicrophoneUsageDescription": "FRIDAY needs microphone access to listen for your voice commands continuously.",
        "NSSpeechRecognitionUsageDescription": "FRIDAY needs speech recognition to understand your commands offline.",
        "NSCameraUsageDescription": "FRIDAY can control your camera on command.",
        "NSContactsUsageDescription": "FRIDAY can access contacts for calling and messaging commands.",
        "NSLocationWhenInUseUsageDescription": "FRIDAY uses location for navigation commands.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FRIDAY uses location for navigation commands.",
        "UIBackgroundModes": ["audio", "fetch", "processing", "remote-notification"]
      }
    },
    "android": {
      "package": "com.friday.assistant",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.CALL_PHONE",
        "android.permission.SEND_SMS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-speech-recognition",
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3B9EFF",
          "defaultChannel": "friday"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "88530a6e-b8f4-4d37-bbb6-9874be1afd7b"
      }
    }
  }
}
